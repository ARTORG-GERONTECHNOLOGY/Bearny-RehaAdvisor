# Node dependencies (images install their own with npm ci)
**/node_modules

# Local env files and secrets
**/.env*
**/*.pem
**/*.key

# Frontend build and test output (images build their own dist)
frontend/dist/
frontend/dev-dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/

# Python caches, logs and local state
venv/
**/__pycache__
**/.pytest_cache
**/*.log
backend/celery*.state*
backend/celerybeat-schedule*
backend/api/*.sqlite3
backend/api/beat.db

# MongoDB data
mongo_data/

# Git metadata
.git/
.gitignore

# Docker artifacts
docker-compose.override.yml
docker-compose.dev.yml

# Certbot secrets and configs
nginx/certbot/conf/
nginx/certbot/www/

# Local tooling and editor files
.claude/
.idea/
**/.DS_Store
**/*.swp
archives/
worktrees/
